# Supabase — ambil dari Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (dipakai bareng untuk Drive & Sheets) — lihat README bagian setup
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Google Sheet buat backup/raw data pelamar — ambil ID dari URL sheet-nya
# (https://docs.google.com/spreadsheets/d/SHEET_ID_DI_SINI/edit)
GOOGLE_SHEET_ID=

# Fonnte — token device WhatsApp, ambil dari dashboard Fonnte (fonnte.com)
FONNTE_TOKEN=
